# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Local-only: other people's sites cloned for reference, not part of this site
reference/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

# Source archives dropped under blog/ while preparing a post. Everything under
# blog/ is published verbatim, so an archive left here would be served to the
# public; ignoring it keeps it out of the deployed copy as well as out of git.
blog/**/*.zip
# Python bytecode from running the deploy scripts locally
__pycache__/
*.pyc

# macOS folder metadata
.DS_Store

# Local working material that is never part of the site: scratch files,
# planning documents, and review reports. blog/review-output/ sits under
# blog/, which is published verbatim, so it must stay out of the deploy too.
tmp/
docs/
blog/review-output/
